{
	"name": "obsidian-ecrire-en-branches",
	"version": "0.1.1",
	"description": "Write in small cards laid out in columns, inside an ordinary Markdown note.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.config.mjs epreuves && node --test test/*.test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:obsidian": "node test/obsidian/demarrage.mjs"
	},
	"keywords": [],
	"author": "DevidCode",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.26.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"playwright-core": "^1.48.0"
	}
}
